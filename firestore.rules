rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tokens/{tokenId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'userAgent', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['web', 'ios'];
      }

      match /completions/{date} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.keys().hasOnly(['completed', 'completedAt', 'updatedAt'])
          && request.resource.data.completed is bool;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
